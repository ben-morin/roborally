{
  "name": "roborally",
  "description": "RoboRally in Meteor",
  "version": "3.5.2",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ben-morin/roborally.git"
  },
  "bugs": {
    "url": "https://github.com/ben-morin/roborally/issues"
  },
  "license": "GPL-2.0",
  "homepage": "https://github.com/ben-morin/roborally#readme",
  "scripts": {
    "start": "meteor run",
    "dev": "meteor run --settings settings-dev.json",
    "test": "vitest run --config test/vitest.config.mjs",
    "test:watch": "vitest --config test/vitest.config.mjs",
    "test:e2e": "playwright test -c test/e2e/playwright.config.js",
    "test:e2e:ui": "playwright test -c test/e2e/playwright.config.js --ui",
    "e2e:install": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,ts,tsx,json,html,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,json,html,css,md}\""
  },
  "dependencies": {
    "@babel/runtime": "^8.0.0",
    "@swc/helpers": "^0.5.17",
    "meteor-node-stubs": "^1.2.29",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.3"
  },
  "meteor": {
    "mainModule": {
      "client": "client/main.js",
      "server": "server/cron.ts"
    },
    "modern": true
  },
  "devDependencies": {
    "@meteorjs/rspack": "^2.2.0",
    "@playwright/test": "^1.62.1",
    "@rsdoctor/rspack-plugin": "^1.6.3",
    "@rspack/cli": "^1.7.1",
    "@rspack/core": "^1.7.1",
    "@rspack/plugin-react-refresh": "^1.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/meteor": "^2.9.11",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-meteor": "^7.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.8.3",
    "react-refresh": "^0.18.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
