{
  "name": "roborally",
  "description": "RoboRally in Meteor",
  "version": "3.5.3",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ben-morin/roborally.git"
  },
  "bugs": {
    "url": "https://github.com/ben-morin/roborally/issues"
  },
  "license": "GPL-2.0",
  "homepage": "https://github.com/ben-morin/roborally#readme",
  "scripts": {
    "start": "meteor run",
    "dev": "meteor run --settings settings-dev.json",
    "test": "vitest run --config test/vitest.config.mjs",
    "test:watch": "vitest --config test/vitest.config.mjs",
    "test:e2e": "playwright test -c test/e2e/playwright.config.js",
    "test:e2e:ui": "playwright test -c test/e2e/playwright.config.js --ui",
    "e2e:install": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,ts,tsx,json,html,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,json,html,css,md}\"",
    "deck:shuffle": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON test/tools/deck-shuffle.mts"
  },
  "dependencies": {
    "@babel/runtime": "^8.0.7",
    "@swc/helpers": "^0.5.17",
    "meteor-node-stubs": "^1.2.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "meteor": {
    "mainModule": {
      "client": "client/main.js",
      "server": "server/main.ts"
    },
    "modern": true
  },
  "devDependencies": {
    "@meteorjs/rspack": "^2.2.0",
    "@playwright/test": "^1.64.1",
    "@rsdoctor/rspack-plugin": "^1.6.5",
    "@rspack/cli": "^1.7.1",
    "@rspack/core": "^1.7.1",
    "@rspack/plugin-react-refresh": "^1.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/meteor": "^2.9.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-meteor": "^7.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.9.10",
    "react-refresh": "^0.19.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  }
}
